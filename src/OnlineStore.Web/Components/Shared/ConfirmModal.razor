@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    @Message
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">@CancelText</button>
                    <button type="button" class="btn btn-danger" @onclick="Confirm">@ConfirmText</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    /// <summary>Whether the modal is visible.</summary>
    [Parameter]
    public bool IsVisible { get; set; }

    /// <summary>Modal title.</summary>
    [Parameter]
    public string Title { get; set; } = "Confirm";

    /// <summary>Modal message body.</summary>
    [Parameter]
    public string Message { get; set; } = string.Empty;

    /// <summary>Confirm button label.</summary>
    [Parameter]
    public string ConfirmText { get; set; } = "Confirm";

    /// <summary>Cancel button label.</summary>
    [Parameter]
    public string CancelText { get; set; } = "Cancel";

    /// <summary>Raised when the user confirms.</summary>
    [Parameter]
    public EventCallback OnConfirmed { get; set; }

    /// <summary>Raised when the user cancels or closes.</summary>
    [Parameter]
    public EventCallback OnCancelled { get; set; }

    private async Task Confirm()
    {
        await OnConfirmed.InvokeAsync();
    }

    private async Task Cancel()
    {
        await OnCancelled.InvokeAsync();
    }
}
