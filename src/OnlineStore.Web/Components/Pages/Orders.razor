@page "/orders"

<PageTitle>Orders</PageTitle>

<div class="page-block">
    <h1 class="page-title">Orders</h1>

    @if (_loading)
    {
        <p class="muted">Loading...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="error-text">@_error</p>
    }
    else if (_orders.Count == 0)
    {
        <p class="muted">No orders found.</p>
    }
    else
    {
        @foreach (var order in _orders)
        {
            <article class="order-card">
                <header class="order-card__header">
                    <span>@order.CreatedAt.ToLocalTime().ToString("g")</span>
                    <strong>@order.TotalPrice.ToString("C")</strong>
                </header>

                <p class="muted order-card__id">@order.Id</p>

                @if (order.Items == null || order.Items.Count == 0)
                {
                    <p class="muted">No items</p>
                }
                else
                {
                    <ul class="order-card__items">
                        @foreach (var item in order.Items)
                        {
                            <li>
                                @item.ProductName × @item.Quantity
                                <span class="muted">
                                    @((item.Price * item.Quantity).ToString("C"))
                                </span>
                            </li>
                        }
                    </ul>
                }
            </article>
        }
    }
</div>

@code {
    [Inject] private IOrderApiService OrderApi { get; set; } = default!;

    private readonly List<OrderDto> _orders = new();

    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var data = await OrderApi.GetAllAsync();

            _orders.Clear();
            _orders.AddRange(data);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load orders: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}