@page "/products/{Id:guid}"
@inject IStoreApiClient Api
@inject ICartService CartService
@inject NavigationManager Navigation

<PageTitle>Product Details</PageTitle>

@if (_loading)
{
    <p>Loading...</p>
}
else if (_product is null)
{
    <p class="text-danger">Product not found.</p>
}
else
{
    <h1>@_product.Name</h1>
    <p class="text-muted">@_product.CategoryName</p>
    <p>@_product.Description</p>
    <p><strong>Price:</strong> @_product.Price.ToString("C")</p>
    <p><strong>Stock:</strong> @_product.StockQuantity</p>

    @if (_product.Tags.Count > 0)
    {
        <p>
            <strong>Tags:</strong>
            @foreach (var tag in _product.Tags)
            {
                <span class="badge bg-secondary me-1">@tag</span>
            }
        </p>
    }

    <div class="d-flex gap-2 align-items-center">
        <label class="form-label mb-0" for="qty">Quantity</label>
        <input id="qty" type="number" class="form-control w-auto" min="1" max="@_product.StockQuantity" @bind="_quantity" />
        <button class="btn btn-primary"
                disabled="@(_product.StockQuantity == 0)"
                @onclick="AddToCart">
            Add to cart
        </button>
        <a class="btn btn-outline-secondary" href="/products">Back to catalog</a>
    </div>
}

@code {
    /// <summary>Product identifier from route.</summary>
    [Parameter]
    public Guid Id { get; set; }

    private ProductDto? _product;
    private bool _loading = true;
    private int _quantity = 1;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _product = await Api.GetProductAsync(Id);
        _loading = false;
    }

    private async Task AddToCart()
    {
        if (_product is null)
        {
            return;
        }

        await CartService.AddItemAsync(_product.Id, _product.Name, _product.Price, _quantity);
        Navigation.NavigateTo("/cart");
    }
}
