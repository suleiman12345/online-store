@page "/products/{ProductId:guid}"

<PageTitle>@(_product?.Name ?? "Product")</PageTitle>

<div class="page-block">
    <a class="back-link" href="/products">← Products</a>

    @if (_loading)
    {
        <p class="muted">Loading...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="error-text">@_error</p>
    }
    else if (_product is null)
    {
        <p class="muted">Product not found.</p>
    }
    else
    {
        <h1 class="page-title">@_product.Name</h1>
        <p class="muted">@_product.CategoryName</p>

        <dl class="detail-list">
            <dt>Price</dt>
            <dd>@_product.Price.ToString("C")</dd>
            <dt>Category</dt>
            <dd>@_product.CategoryName</dd>
            <dt>Stock</dt>
            <dd>@_product.StockQuantity</dd>
        </dl>

        <button class="btn-primary"
                disabled="@_busy"
                @onclick="AddToCartAsync">
            @(_busy ? "Adding..." : "Add to cart")
        </button>

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="success-text">@_message</p>
        }
    }
</div>

@code {
    [Parameter]
    public Guid ProductId { get; set; }

    [Inject]
    private IProductApiService ProductApi { get; set; } = default!;

    [Inject]
    private ICartApiService CartApi { get; set; } = default!;

    [Inject]
    private ICartIdService CartIdService { get; set; } = default!;

    private ProductDto? _product;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _message;

    protected override async Task OnParametersSetAsync()
    {
        await LoadProductAsync();
    }

    private async Task LoadProductAsync()
    {
        _loading = true;
        _error = null;
        _message = null;

        try
        {
            _product = await ProductApi.GetByIdAsync(ProductId);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load product: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddToCartAsync()
    {
        if (_product is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        _message = null;

        try
        {
            await CartIdService.EnsureInitializedAsync();
            var cartId = await CartIdService.GetCartIdAsync();
            var cart = await CartApi.AddItemAsync(cartId, _product.Id);
            var count = cart?.Items.Sum(x => x.Quantity) ?? 0;
            _message = $"Added to cart ({count} item(s)).";
        }
        catch (Exception ex)
        {
            _error = $"Failed to add to cart: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
